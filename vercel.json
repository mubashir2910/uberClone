{
  "version": 2,
  "builds": [
    { 
      "src": "BACKEND/server.js", 
      "use": "@vercel/node" 
    },
    { 
      "src": "FRONTEND/package.json", 
      "use": "@vercel/static-build",
      "config": { 
        "distDir": "dist"
      } 
    }
  ],
  "routes": [
    { "src": "/api/users/(.*)", "dest": "/BACKEND/server.js" },
    { "src": "/api/captains/(.*)", "dest": "/BACKEND/server.js" },
    { "src": "/api/rides/(.*)", "dest": "/BACKEND/server.js" },
    { "src": "/api/maps/(.*)", "dest": "/BACKEND/server.js" },
    { "src": "/(.*)", "dest": "/FRONTEND/dist/$1" }
  ]
}