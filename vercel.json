{
  "version": 2,
  "builds": [
    {
      "src": "BACKEND/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "FRONTEND/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "FRONTEND/dist"
      }
    }
  ],
  "routes": [
    { "src": "/users/(.*)", "dest": "BACKEND/server.js" },
    { "src": "/captains/(.*)", "dest": "BACKEND/server.js" },
    { "src": "/rides/(.*)", "dest": "BACKEND/server.js" },
    { "src": "/maps/(.*)", "dest": "BACKEND/server.js" },
    { "src": "/(.*)", "dest": "FRONTEND/dist/$1" }
  ]
}
